# ───────────── Core ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://forged:forged@localhost:5432/forged
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ───────────── AI providers (at least one) ─────────────
# Claude models (Fable 5.1, Opus 5.5, Sonnet 5.5, Haiku 5.5)
ANTHROPIC_API_KEY=
# GPT, Gemini, Grok, DeepSeek, Qwen, Kimi… through OpenRouter
OPENROUTER_API_KEY=
# Optional: default model id (see src/lib/ai/models.ts)
FORGED_DEFAULT_MODEL=claude-sonnet-5-5
# Offline demo agent: 1 = always on, 0 = off. Defaults to on in development when no key is set.
FORGED_MOCK_AI=

# ───────────── Project VMs (live Next.js previews) ─────────────
# docker (self-hosted, default) | e2b (cloud microVMs) | none
FORGED_SANDBOX_PROVIDER=docker
FORGED_RUNTIME_IMAGE=forged-runtime:latest
# How the browser reaches a container's port 3000. {port} = host port, {ip} = container IP.
FORGED_PREVIEW_URL_TEMPLATE=http://localhost:{port}
FORGED_SANDBOX_IDLE_MIN=30
FORGED_SANDBOX_MEMORY_MB=2048
FORGED_SANDBOX_CPUS=2
# E2B (when FORGED_SANDBOX_PROVIDER=e2b)
E2B_API_KEY=
E2B_TEMPLATE=forged-nextjs

# ───────────── Credits ─────────────
SIGNUP_BONUS_USD=1
REFERRAL_REWARD_USD=5
REFEREE_REWARD_USD=5
# Price multiplier on top of provider cost
CREDIT_MARKUP=1.25

# ───────────── OAuth (optional) ─────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────── Email (optional, password reset) ─────────────
RESEND_API_KEY=
EMAIL_FROM="Forged.dev <noreply@forged.dev>"

# ───────────── Stripe (optional, billing) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
